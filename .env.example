# ==========================================================================
# ATTOS RH — VARIÁVEIS DE AMBIENTE
# ==========================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA faça commit do arquivo .env (ele está no .gitignore).
#
# Esta lista é COMPLETA: toda variável que o código lê está aqui. Se você
# acrescentar um `process.env.ALGUMA_COISA` no código, acrescente aqui também,
# senão quem for configurar o servidor não tem como saber que ela existe.
# ==========================================================================


# ─── OBRIGATÓRIA ─────────────────────────────────────────────────────────
# Senha da conta `admin`. SEM ELA O SERVIDOR NÃO SOBE — ele para na hora e
# explica o motivo, em vez de criar a conta sem senha e deixar o painel
# inacessível (ou meio aberto).
# Ela vale só na PRIMEIRA vez, quando a conta `admin` ainda não tem senha.
# Depois disso, a senha de quem já usa o sistema não é afetada por esta
# variável — a troca é feita pelo próprio painel.
# Gere uma boa com: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_SENHA=


# ─── SERVIDOR ────────────────────────────────────────────────────────────
# Porta onde o servidor escuta. Local: 3000. No contêiner: 80 (o Dockerfile
# já define). Deixe em branco para usar 3000.
PORT=3000

# Pasta onde ficam TODOS os dados: state.json, uploads/, backups/, o banco do
# WhatsApp e as mídias. Local: ./server-data. No contêiner: /data, que PRECISA
# ser um volume persistente do Coolify — sem o volume, cada deploy sobe vazio.
DATA_DIR=./server-data

# `production` liga os comportamentos de produção (entre eles, esconder as
# senhas-semente nos avisos de inicialização). Em branco = desenvolvimento.
# O Dockerfile já define NODE_ENV=production na imagem.
NODE_ENV=

# URL pública do sistema. Usada para montar os links que saem do servidor —
# entre eles o endereço da mídia que o WhatsApp precisa baixar.
# Exemplos: https://seudominio.com.br  ou  https://app.seudominio.com.br
APP_URL=


# ─── WHATSAPP CLOUD API (META) ───────────────────────────────────────────
# Token de verificação do webhook — escolha uma string aleatória segura.
# Este mesmo token deve ser informado no Meta Developer ao configurar o webhook.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=

# App Secret do aplicativo Meta (Meta Developer > Configurações do App >
# Básico > Chave Secreta). Valida a assinatura X-Hub-Signature-256 dos
# webhooks: sem ele, qualquer um poderia forjar uma mensagem recebida.
WHATSAPP_APP_SECRET=

# Chave para CIFRAR o Access Token dentro do banco (recomendado).
# Com ela, quem copiar o arquivo whatsapp.db NÃO consegue ler os tokens.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ATENÇÃO: guarde esta chave. Se ela for perdida ou trocada, os tokens já
# gravados param de ser lidos e será preciso cadastrar os tokens de novo em
# WhatsApp > Conexões (nenhum outro dado do sistema é afetado).
# Se deixar em branco, o sistema funciona igual — só sem a cifra.
WHATSAPP_CRYPTO_KEY=

# Endereço base da API da Meta. Só mexa para fixar outra versão da API ou
# para apontar para um servidor de teste. Em branco = o padrão do código.
META_API_BASE=


# ─── ÁUDIO (mensagem de voz gravada na tela) ─────────────────────────────
# Caminho do ffmpeg, quando ele não está no PATH. O ffmpeg converte o áudio
# que o navegador grava (WEBM/Opus) para OGG/Opus, que é o formato que a Meta
# mostra como MENSAGEM DE VOZ. Em branco = procura `ffmpeg` no PATH.
# Sem ffmpeg o sistema sobe igual: só a gravação pela tela avisa que não dá,
# e o envio de áudio por ARQUIVO continua funcionando.
# O Dockerfile já instala o ffmpeg na imagem.
FFMPEG_BIN=


# ─── NOTAS ───────────────────────────────────────────────────────────────
# O Access Token, Phone Number ID, WABA ID e as demais credenciais de cada
# número de WhatsApp são cadastrados PELA INTERFACE (aba WhatsApp > Conexões,
# que aceita vários números) e ficam no banco SQLite, cifrados.
# NÃO coloque Access Token aqui — ele é gerenciado pelo sistema.
#
# ─── CONFIGURAÇÃO DO WEBHOOK NO META DEVELOPER ──────────────────────────
# 1. Acesse: https://developers.facebook.com/apps/SEU_APP_ID/whatsapp-business/wa-settings/
# 2. Na seção "Webhook", clique em "Editar"
# 3. URL do callback: APP_URL + /webhooks/whatsapp
#    Exemplo: https://seudominio.com.br/webhooks/whatsapp
# 4. Token de verificação: cole o mesmo valor de WHATSAPP_VERIFY_TOKEN
# 5. Clique em "Verificar e salvar"
# 6. Marque o campo: messages (obrigatório)
# ==========================================================================
