# ==========================================================================
# R&T EMPREGOS — VARIÁVEIS DE AMBIENTE
# ==========================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA faça commit do arquivo .env no Git.
# ==========================================================================

# ─── SERVIDOR R&T ─────────────────────────────────────────────────────────
PORT=3000
DATA_DIR=./server-data

# URL pública do sistema (usada para links, webhooks, etc.)
# Exemplos: https://seudominio.com ou https://app.seudominio.com
APP_URL=

# ─── WHATSAPP CLOUD API (META) ───────────────────────────────────────────
# Token de verificação do webhook — escolha uma string aleatória segura.
# Este mesmo token deve ser informado no Meta Developer ao configurar o webhook.
# Exemplo: gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=

# App Secret do aplicativo Meta (encontrado em Meta Developer > Configurações do App > Básico > Chave Secreta).
# Usado para validar a assinatura X-Hub-Signature-256 dos webhooks.
WHATSAPP_APP_SECRET=

# ─── NOTAS IMPORTANTES ──────────────────────────────────────────────────
# O Access Token, Phone Number ID, WABA ID e outras credenciais de cada
# conta WhatsApp são configurados pela interface de administração do sistema
# (aba WhatsApp > Conexões — suporta VÁRIOS números) e ficam salvos no banco de dados SQLite.
#
# NÃO coloque o Access Token aqui — ele é gerenciado pelo sistema.
#
# ─── CONFIGURAÇÃO DO WEBHOOK NO META DEVELOPER ──────────────────────────
# 1. Acesse: https://developers.facebook.com/apps/SEU_APP_ID/whatsapp-business/wa-settings/
# 2. Na seção "Webhook", clique em "Editar"
# 3. URL do callback: https://SEU_DOMINIO/webhooks/whatsapp
# 4. Token de verificação: cole o mesmo valor de WHATSAPP_VERIFY_TOKEN
# 5. Clique em "Verificar e salvar"
# 6. Marque os campos: messages (obrigatório)
#
# ─── ONDE COLOCAR O DOMÍNIO ─────────────────────────────────────────────
# Sua URL de webhook será: APP_URL + /webhooks/whatsapp
# Exemplo: https://api.seudominio.com/webhooks/whatsapp
#
# Configure APP_URL acima com seu domínio real quando for fazer deploy.
# ==========================================================================
